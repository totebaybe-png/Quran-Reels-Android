<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launcher icon for devices below API 26 (no adaptive icons).
     Newer devices prefer the adaptive icon in mipmap-anydpi-v26.
     Implemented as a vector so it stays crisp at every density without
     shipping per-density PNGs. -->
